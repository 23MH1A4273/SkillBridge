rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper: check if the user is authenticated at all
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: check if the user is an admin
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Personal Data collections
    match /userSkills/{userId} { allow read, write: if isOwner(userId) || isAdmin(); }
    match /applications/{userId}/{document=**} { allow read, write: if isOwner(userId) || isAdmin(); }
    match /roadmaps/{userId} { allow read, write: if isOwner(userId) || isAdmin(); }
    match /careerReports/{userId} { allow read, write: if isOwner(userId) || isAdmin(); }
    match /analytics/{userId} { allow read, write: if isOwner(userId) || isAdmin(); }
    match /interviewSessions/{userId}/{document=**} { allow read, write: if isOwner(userId) || isAdmin(); }
    match /quizResults/{userId} { allow read, write: if isOwner(userId) || isAdmin(); }

    // Support tickets
    match /supportTickets/{ticketId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Mentor profiles
    match /mentors/{mentorId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(mentorId) || isAdmin();
    }

    // Shared Read-Only collections
    match /jobs/{jobId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /liveJobs/{jobId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /matchResults/{matchId} { 
      allow read, write: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()); 
    }

    // Admin-Only collections
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
    match /adminLogs/{document=**} {
      allow read, write: if isAdmin();
    }

    // Global Deny
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
